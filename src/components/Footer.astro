---
import { FaFacebookF, FaInstagram, FaLinkedin } from "react-icons/fa";

import { Mail, Phone, MapPin, ChevronRight } from "lucide-react";
---

<footer
    class="relative
    overflow-hidden
    bg-[#020617]
    text-white
    border-t
    border-white/10"
>
    <!-- Glow -->
    <div
        class="absolute
      top-0
      left-1/2
      -translate-x-1/2
      w-[900px]
      h-[500px]
      bg-cyan-500/10
      blur-3xl
      rounded-full"
    >
    </div>

    <div
        class="relative
      z-10
      max-w-7xl
      mx-auto
      px-6
      pt-24
      pb-10"
    >
        <!-- GRID -->
        <div
            class="grid
    grid-cols-1
    md:grid-cols-2
    lg:grid-cols-[1.2fr_0.8fr_1fr]
    gap-20
    lg:gap-16
    items-start"
        >
            <!-- EMPRESA -->
            <div class="max-w-md">
                <!-- Logo -->
                <div class="mb-8">
                    <img
                        src="/fondo_white_1.png"
                        alt="Mobile Tic"
                        class="h-28 w-auto"
                    />
                </div>

                <!-- Texto -->
                <p
                    class="text-slate-400
        leading-relaxed
        text-lg
        mb-10"
                >
                    Plataforma tecnológica especializada en sistemas de
                    facturación, recaudo y operación para acueductos rurales.
                </p>

                <!-- Redes -->
                <div class="flex items-center gap-4">
                    <a
                        href="#"
                        class="w-12
            h-12
            rounded-2xl
            border
            border-white/10
            bg-white/5
            hover:bg-cyan-500
            hover:text-slate-950
            transition-all
            duration-300
            flex
            items-center
            justify-center
            hover:scale-110"
                    >
                        <FaFacebookF size={18} />
                    </a>

                    <a
                        href="https://www.instagram.com/mobileticsas?igsh=bmE3OHhybDBjcGx2"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-12
                            h-12
                            rounded-2xl
                            border
                            border-white/10
                            bg-white/5
                            hover:bg-cyan-500
                            hover:text-slate-950
                            transition-all
                            duration-300
                            flex
                            items-center
                            justify-center
                            hover:scale-110"
                    >
                        <FaInstagram size={18} />
                    </a>

                    <a
                        href="#"
                        class="w-12
            h-12
            rounded-2xl
            border
            border-white/10
            bg-white/5
            hover:bg-cyan-500
            hover:text-slate-950
            transition-all
            duration-300
            flex
            items-center
            justify-center
            hover:scale-110"
                    >
                        <FaLinkedin size={18} />
                    </a>
                </div>
            </div>

            <!-- NAVEGACIÓN -->
            <div>
                <h3
                    class="text-2xl
        font-bold
        mb-10
        text-white"
                >
                    Navegación
                </h3>

                <ul class="space-y-6">
                    <li>
                        <a
                            href="/"
                            class="group
              flex
              items-center
              gap-4
              text-slate-300
              hover:text-cyan-400
              transition-all
              duration-300"
                        >
                            <div
                                class="w-10
                h-10
                rounded-xl
                bg-white/5
                border
                border-white/10
                flex
                items-center
                justify-center
                group-hover:bg-cyan-500/10
                group-hover:border-cyan-400/20
                transition-all"
                            >
                                <ChevronRight size={18} />
                            </div>

                            <span class="text-lg">Inicio</span>
                        </a>
                    </li>

                    <li>
                        <a
                            href="#servicios"
                            class="group
              flex
              items-center
              gap-4
              text-slate-300
              hover:text-cyan-400
              transition-all
              duration-300"
                        >
                            <div
                                class="w-10
                h-10
                rounded-xl
                bg-white/5
                border
                border-white/10
                flex
                items-center
                justify-center
                group-hover:bg-cyan-500/10
                group-hover:border-cyan-400/20
                transition-all"
                            >
                                <ChevronRight size={18} />
                            </div>

                            <span class="text-lg">Servicios</span>
                        </a>
                    </li>

                    <li>
                        <a
                            href="#caracteristicas"
                            class="group
              flex
              items-center
              gap-4
              text-slate-300
              hover:text-cyan-400
              transition-all
              duration-300"
                        >
                            <div
                                class="w-10
                h-10
                rounded-xl
                bg-white/5
                border
                border-white/10
                flex
                items-center
                justify-center
                group-hover:bg-cyan-500/10
                group-hover:border-cyan-400/20
                transition-all"
                            >
                                <ChevronRight size={18} />
                            </div>

                            <span class="text-lg">Características</span>
                        </a>
                    </li>

                    <li>
                        <a
                            href="#contacto"
                            class="group
              flex
              items-center
              gap-4
              text-slate-300
              hover:text-cyan-400
              transition-all
              duration-300"
                        >
                            <div
                                class="w-10
                h-10
                rounded-xl
                bg-white/5
                border
                border-white/10
                flex
                items-center
                justify-center
                group-hover:bg-cyan-500/10
                group-hover:border-cyan-400/20
                transition-all"
                            >
                                <ChevronRight size={18} />
                            </div>

                            <span class="text-lg">Contacto</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- CONTACTO -->
            <div>
                <h3
                    class="text-2xl
        font-bold
        mb-10
        text-white"
                >
                    Contacto
                </h3>

                <div class="space-y-7">
                    <!-- Ubicación -->
                    <div class="flex
          items-start
          gap-5">
                        <div
                            class="w-14
            h-14
            rounded-2xl
            bg-cyan-500/10
            border
            border-cyan-400/20
            flex
            items-center
            justify-center
            shrink-0"
                        >
                            <MapPin size={24} className="text-cyan-400" />
                        </div>

                        <div>
                            <p
                                class="text-slate-500
              text-sm
              uppercase
              tracking-[0.2em]
              mb-2"
                            >
                                Ubicación
                            </p>

                            <p
                                class="text-slate-100
              text-lg
              leading-relaxed"
                            >
                                Antioquia, Colombia
                            </p>
                        </div>
                    </div>

                    <!-- Teléfono -->
                    <div class="flex
          items-start
          gap-5">
                        <div
                            class="w-14
            h-14
            rounded-2xl
            bg-cyan-500/10
            border
            border-cyan-400/20
            flex
            items-center
            justify-center
            shrink-0"
                        >
                            <Phone size={24} className="text-cyan-400" />
                        </div>

                        <div>
                            <p
                                class="text-slate-500
              text-sm
              uppercase
              tracking-[0.2em]
              mb-2"
                            >
                                Teléfono
                            </p>

                            <p class="text-slate-100
              text-lg">
                                +57 324 678 7620
                            </p>
                        </div>
                    </div>

                    <!-- Correo -->
                    <div class="flex
          items-start
          gap-5">
                        <div
                            class="w-14
            h-14
            rounded-2xl
            bg-cyan-500/10
            border
            border-cyan-400/20
            flex
            items-center
            justify-center
            shrink-0"
                        >
                            <Mail size={24} className="text-cyan-400" />
                        </div>

                        <div>
                            <p
                                class="text-slate-500
              text-sm
              uppercase
              tracking-[0.2em]
              mb-2"
                            >
                                Correo
                            </p>

                            <p
                                class="text-slate-100
              text-lg
              break-all"
                            >
                                info@mobile-tic.com
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom -->
        <div
            class="mt-20
        pt-8
        border-t
        border-white/10
        flex
        flex-col
        md:flex-row
        items-center
        justify-between
        gap-6"
        >
            <p class="text-slate-500 text-sm text-center md:text-left">
                © 2026 Mobile Tic. Todos los derechos reservados.
            </p>

            <div
                class="flex
          items-center
          gap-6
          text-sm
          text-slate-500"
            >
                <a href="#" class="hover:text-cyan-400 transition-all">
                    Política de privacidad
                </a>

                <a href="#" class="hover:text-cyan-400 transition-all">
                    Términos y condiciones
                </a>
            </div>
        </div>
    </div>
</footer>
