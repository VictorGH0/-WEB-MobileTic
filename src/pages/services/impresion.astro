---
import Layout from "../../pages/Layout.astro";
import Navbar from "../../components/Navbar.jsx";
import Footer from "../../components/Footer.astro";

import {
    Droplets,
    Printer,
    WifiOff,
    BarChart3,
    ShieldCheck,
    Database,
    ArrowRight,
    ClipboardPlus,
    ShieldOff,
    UserStar,
    Zap,
    Smartphone,
    RefreshCcw,
} from "lucide-react";
---

<Layout>
    <!-- SECCIÓN 1 -->
    <section
        id="plataforma"
        class="relative overflow-hidden bg-white py-32 px-6"
    >
        <!-- Glow decorativo -->
        <div
            class="absolute
        top-0
        left-1/2
        -translate-x-1/2
        w-[900px]
        h-[900px]
        bg-cyan-100/40
        rounded-full
        blur-3xl"
        >
        </div>

        <div class="relative z-10 max-w-7xl mx-auto">
            <!-- HEADER -->
            <div class="text-center max-w-4xl mx-auto mb-24">
                <p
                    class="uppercase
                tracking-[0.35em]
                text-cyan-600
                font-semibold
                mb-6"
                >
                    Plataforma móvil inteligente
                </p>

                <h2
                    class="text-5xl
                md:text-7xl
                font-bold
                text-slate-900
                leading-[1]
                tracking-tight
                mb-8"
                >
                    Soluciones móviles para
                    <span class="text-cyan-600"> trabajo en campo </span>
                </h2>

                <p
                    class="text-xl
                md:text-2xl
                text-slate-600
                leading-relaxed
                max-w-3xl
                mx-auto"
                >
                    Optimiza la toma de lecturas y la facturación desde
                    dispositivos móviles con sincronización automática y
                    operación en tiempo real.
                </p>
            </div>

            <!-- IMÁGENES -->
            <div
                class="grid
            lg:grid-cols-2
            gap-14
            items-center"
            >
                <!-- CARD 1 -->
                <div class="relative group">
                    <!-- Glow -->
                    <div
                        class="absolute
                    inset-0
                    bg-cyan-500/10
                    blur-3xl
                    rounded-full"
                    >
                    </div>

                    <div
                        class="relative
                    rounded-[2.5rem]
                    overflow-hidden
                    border
                    border-slate-200
                    bg-white
                    rotate-[-2deg]
                    group-hover:rotate-0
                    transition-all
                    duration-700
                    shadow-[0_40px_120px_-20px_rgba(0,0,0,0.18)]"
                    >
                        <!-- Barra superior -->
                        <div
                            class="h-14
                        bg-slate-950
                        flex
                        items-center
                        px-6
                        gap-3"
                        >
                            <div class="w-3 h-3 rounded-full bg-red-400"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-400">
                            </div>
                            <div class="w-3 h-3 rounded-full bg-green-400">
                            </div>
                        </div>

                        <!-- Imagen -->
                        <img
                            src="/Aquasitio_1.jpeg"
                            alt="Lectura móvil"
                            class="w-full h-full object-cover"
                        />

                        <!-- Overlay -->
                        <div
                            class="absolute
                        inset-0
                        bg-gradient-to-t
                        from-slate-950/20
                        via-transparent
                        to-transparent"
                        >
                        </div>
                    </div>
                </div>

                <!-- CARD 2 -->
                <div class="relative group">
                    <!-- Glow -->
                    <div
                        class="absolute
                    inset-0
                    bg-cyan-500/10
                    blur-3xl
                    rounded-full"
                    >
                    </div>

                    <div
                        class="relative
                    rounded-[2.5rem]
                    overflow-hidden
                    border
                    border-slate-200
                    bg-white
                    rotate-[2deg]
                    group-hover:rotate-0
                    transition-all
                    duration-700
                    shadow-[0_40px_120px_-20px_rgba(0,0,0,0.18)]"
                    >
                        <!-- Barra superior -->
                        <div
                            class="h-14
                        bg-slate-950
                        flex
                        items-center
                        px-6
                        gap-3"
                        >
                            <div class="w-3 h-3 rounded-full bg-red-400"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-400">
                            </div>
                            <div class="w-3 h-3 rounded-full bg-green-400">
                            </div>
                        </div>

                        <!-- Imagen -->
                        <img
                            src="/Aquasitio_2.jpeg"
                            alt="Impresión en sitio"
                            class="w-full h-full object-cover"
                        />

                        <!-- Overlay -->
                        <div
                            class="absolute
                        inset-0
                        bg-gradient-to-t
                        from-slate-950/20
                        via-transparent
                        to-transparent"
                        >
                        </div>
                    </div>
                </div>
            </div>

            <!-- BENEFICIOS -->
            <div
                class="grid
            md:grid-cols-2
            lg:grid-cols-4
            gap-6
            mt-24"
            >
                <!-- CARD -->
                <div
                    class="bg-white
                border
                border-slate-200
                rounded-3xl
                p-8
                shadow-lg
                hover:-translate-y-2
                transition-all
                duration-300"
                >
                    <div
                        class="w-14
                    h-14
                    rounded-2xl
                    bg-cyan-100
                    flex
                    items-center
                    justify-center
                    mb-6"
                    >
                        <Zap size={28} className="text-cyan-700" />
                    </div>

                    <h3
                        class="text-2xl
                    font-medium
                    text-slate-900
                    mb-3"
                    >
                        Más rapidez
                    </h3>

                    <p class="text-slate-600 leading-relaxed">
                        Reduce tiempos operativos y mejora la atención en campo.
                    </p>
                </div>

                <!-- CARD -->
                <div
                    class="bg-white
                border
                border-slate-200
                rounded-3xl
                p-8
                shadow-lg
                hover:-translate-y-2
                transition-all
                duration-300"
                >
                    <div
                        class="w-14
                    h-14
                    rounded-2xl
                    bg-cyan-100
                    flex
                    items-center
                    justify-center
                    mb-6"
                    >
                        <Smartphone size={28} className="text-cyan-700" />
                    </div>

                    <h3
                        class="text-2xl
                    font-medium
                    text-slate-900
                    mb-3"
                    >
                        Operación móvil
                    </h3>

                    <p class="text-slate-600 leading-relaxed">
                        Gestiona procesos directamente desde dispositivos
                        móviles.
                    </p>
                </div>

                <!-- CARD -->
                <div
                    class="bg-white
                border
                border-slate-200
                rounded-3xl
                p-8
                shadow-lg
                hover:-translate-y-2
                transition-all
                duration-300"
                >
                    <div
                        class="w-14
                    h-14
                    rounded-2xl
                    bg-cyan-100
                    flex
                    items-center
                    justify-center
                    mb-6"
                    >
                        <RefreshCcw size={28} className="text-cyan-700" />
                    </div>

                    <h3
                        class="text-2xl
                    font-medium
                    text-slate-900
                    mb-3"
                    >
                        Sincronización automática
                    </h3>

                    <p class="text-slate-600 leading-relaxed">
                        Información actualizada en tiempo real desde cualquier
                        lugar.
                    </p>
                </div>

                <!-- CARD -->
                <div
                    class="bg-white
                border
                border-slate-200
                rounded-3xl
                p-8
                shadow-lg
                hover:-translate-y-2
                transition-all
                duration-300"
                >
                    <div
                        class="w-14
                    h-14
                    rounded-2xl
                    bg-cyan-100
                    flex
                    items-center
                    justify-center
                    mb-6"
                    >
                        <Printer size={28} className="text-cyan-700" />
                    </div>

                    <h3
                        class="text-2xl
                    font-medium
                    text-slate-900
                    mb-3"
                    >
                        Facturación inmediata
                    </h3>

                    <p class="text-slate-600 leading-relaxed">
                        Genera e imprime facturas directamente en sitio.
                    </p>
                </div>
            </div>
        </div>
    </section>
</Layout>
