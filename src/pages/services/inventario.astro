---
import Layout from "../../pages/Layout.astro";
import Navbar from "../../components/Navbar.jsx";
import Footer from "../../components/Footer.astro";

import {
    Droplets,
    Printer,
    WifiOff,
    BarChart3,
    ShieldCheck,
    Database,
    ArrowRight,
    ClipboardPlus,
    ShieldOff,
    UserStar,
    Zap,
    Smartphone,
    RefreshCcw,
} from "lucide-react";
---

<Layout>
    <!-- SECCIÓN INVENTARIO -->
    <section
        id="inventario"
        class="relative overflow-hidden bg-slate-50 py-32 px-6"
    >
        <!-- Glow -->
        <div
            class="absolute
        top-0
        right-0
        w-[700px]
        h-[700px]
        bg-white-300/20
        rounded-full
        blur-3xl"
        >
        </div>

        <div class="relative z-10 max-w-7xl mx-auto">
            <!-- CONTENIDO -->
            <div
                class="grid
            lg:grid-cols-2
            gap-16
            items-center"
            >
                <!-- IMAGEN -->
                <div class="relative group">
                    <!-- Glow -->
                    <div
                        class="absolute
                    inset-0
                    bg-amber-400/10
                    blur-3xl
                    rounded-full"
                    >
                    </div>

                    <!-- Card -->
                    <div
                        class="relative
                    rounded-[2.5rem]
                    overflow-hidden
                    border
                    border-slate-200
                    bg-white
                    rotate-[-2deg]
                    group-hover:rotate-0
                    transition-all
                    duration-700
                    shadow-[0_40px_120px_-20px_rgba(0,0,0,0.18)]"
                    >
                        <!-- Barra superior -->
                        <div
                            class="h-14
                        bg-slate-950
                        flex
                        items-center
                        px-6
                        gap-3"
                        >
                            <div class="w-3 h-3 rounded-full bg-red-400"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-400">
                            </div>
                            <div class="w-3 h-3 rounded-full bg-green-400">
                            </div>
                        </div>

                        <!-- Imagen -->
                        <img
                            src="/inventario.jpeg"
                            alt="Módulo de inventario"
                            class="w-full h-full object-cover"
                        />

                        <!-- Overlay -->
                        <div
                            class="absolute
                        inset-0
                        bg-gradient-to-t
                        from-slate-950/20
                        via-transparent
                        to-transparent"
                        >
                        </div>
                    </div>
                </div>

                <!-- INFORMACIÓN -->
                <div>
                    <div class="space-y-10">
                        <!-- ITEM -->
                        <div
                            class="flex
                        items-start
                        gap-5"
                        >
                            <div
                                class="w-16
                            h-16
                            rounded-2xl
                            bg-cyan-100
                            flex
                            items-center
                            justify-center
                            shrink-0"
                            >
                                <Database size={32} className="text-cyan-700" />
                            </div>

                            <div>
                                <h3
                                    class="text-2xl
                                font-medium
                                text-slate-900
                                mb-3"
                                >
                                    Control total de inventario
                                </h3>

                                <p
                                    class="text-lg
                                text-slate-600
                                leading-relaxed"
                                >
                                    Gestiona productos, materiales e insumos
                                    desde una sola plataforma centralizada.
                                </p>
                            </div>
                        </div>

                        <!-- ITEM -->
                        <div
                            class="flex
                        items-start
                        gap-5"
                        >
                            <div
                                class="w-16
                            h-16
                            rounded-2xl
                            bg-cyan-100
                            flex
                            items-center
                            justify-center
                            shrink-0"
                            >
                                <BarChart3
                                    size={32}
                                    className="text-cyan-700"
                                />
                            </div>

                            <div>
                                <h3
                                    class="text-2xl
                                font-medium
                                text-slate-900
                                mb-3"
                                >
                                    Kardex y trazabilidad
                                </h3>

                                <p
                                    class="text-lg
                                text-slate-600
                                leading-relaxed"
                                >
                                    Lleva seguimiento detallado de entradas,
                                    salidas y movimientos en tiempo real.
                                </p>
                            </div>
                        </div>

                        <!-- ITEM -->
                        <div
                            class="flex
                        items-start
                        gap-5"
                        >
                            <div
                                class="w-16
                            h-16
                            rounded-2xl
                            bg-cyan-100
                            flex
                            items-center
                            justify-center
                            shrink-0"
                            >
                                <ShieldCheck
                                    size={32}
                                    className="text-cyan-700"
                                />
                            </div>

                            <div>
                                <h3
                                    class="text-2xl
                                font-medium
                                text-slate-900
                                mb-3"
                                >
                                    Integración operativa
                                </h3>

                                <p
                                    class="text-lg
                                text-slate-600
                                leading-relaxed"
                                >
                                    Conecta inventario con compras, facturación
                                    y procesos administrativos.
                                </p>
                            </div>
                        </div>

                        <!-- ITEM -->
                        <div
                            class="flex
                        items-start
                        gap-5"
                        >
                            <div
                                class="w-16
                            h-16
                            rounded-2xl
                            bg-cyan-100
                            flex
                            items-center
                            justify-center
                            shrink-0"
                            >
                                <ClipboardPlus
                                    size={32}
                                    className="text-cyan-700"
                                />
                            </div>

                            <div>
                                <h3
                                    class="text-2xl
                                font-medium
                                text-slate-900
                                mb-3"
                                >
                                    Reportes automáticos
                                </h3>

                                <p
                                    class="text-lg
                                text-slate-600
                                leading-relaxed"
                                >
                                    Obtén información actualizada y reportes
                                    inteligentes para una mejor toma de
                                    decisiones.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STATS -->
            <div
                class="grid
            md:grid-cols-2
            gap-50
            mt-24"
            >
                <!-- CARD -->
                <div
                    class="bg-white
                border
                border-slate-200
                rounded-3xl
                p-10
                text-center
                shadow-lg"
                >
                    <h3
                        class="text-5xl
                    font-medium
                    text-cyan-700
                    mb-4"
                    >
                        100%
                    </h3>

                    <p
                        class="text-xl
                    font-semibold
                    text-slate-900"
                    >
                        Control de movimientos
                    </p>
                </div>

                <!-- CARD -->
                <div
                    class="bg-white
                border
                border-slate-200
                rounded-3xl
                p-10
                text-center
                shadow-lg"
                >
                    <h3
                        class="text-5xl
                     font-medium
                    text-cyan-700
                    mb-4"
                    >
                        +50%
                    </h3>

                    <p
                        class="text-xl
                    font-semibold
                    text-slate-900"
                    >
                        Optimización operativa
                    </p>
                </div>
            </div>
        </div>
    </section>
</Layout>
