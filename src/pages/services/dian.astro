---
import Layout from "../../pages/Layout.astro";
import Navbar from "../../components/Navbar.jsx";
import Footer from "../../components/Footer.astro";

import {
    Droplets,
    Printer,
    WifiOff,
    BarChart3,
    ShieldCheck,
    Database,
    ArrowRight,
    ClipboardPlus,
    ShieldOff,
    UserStar,
    Navigation,
    BookCheck,
} from "lucide-react";
---

<Layout>
    <!-- SECCIÓN 1 -->
    <section id="plataforma" class="bg-white py-32 px-6">
        <div
            class="max-w-7xl
            mx-auto
            grid
            lg:grid-cols-2
            gap-24
            items-center"
        >
            <!-- Mockup -->
            <div class="relative">
                <div
                    class="absolute
                    inset-0
                    bg-cyan-500/10
                    blur-3xl
                    rounded-full"
                >
                </div>

                <div
                    class="relative
                    rounded-[2rem]
                    border
                    border-slate-200
                    bg-slate-50
                    overflow-hidden
                    shadow-2xl"
                >
                    <!-- VISUAL PREMIUM -->
                    <div class="relative">
                        <!-- Glow -->
                        <div
                            class="absolute
                            -inset-10
                            bg-cyan-500/20
                            blur-3xl
                            rounded-full"
                        >
                        </div>

                        <!-- Imagen principal -->
                        <div
                            class="relative
                            rounded-[2.5rem]
                            overflow-hidden
                            border
                            border-white/10
                            shadow-[0_40px_120px_-20px_rgba(0,0,0,0.45)]
                            bg-white
                            rotate-[-2deg]
                            hover:rotate-0
                            transition-all
                            duration-700"
                        >
                            <!-- Barra superior -->
                            <div
                                class="h-14
                                bg-slate-950
                                flex
                                items-center
                                px-6
                                gap-3"
                            >
                                <div class="w-3 h-3 rounded-full bg-red-400">
                                </div>
                                <div class="w-3 h-3 rounded-full bg-yellow-400">
                                </div>
                                <div class="w-3 h-3 rounded-full bg-green-400">
                                </div>
                            </div>

                            <!-- Imagen -->
                            <img
                                src="/dian.png"
                                alt="Sistema de facturación"
                                class="w-full h-full object-cover"
                            />

                            <!-- Overlay elegante -->
                            <div
                                class="absolute
                                inset-0
                                bg-gradient-to-t
                                from-slate-950/30
                                via-transparent
                                to-transparent"
                            >
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Texto -->
            <div>
                <h2
                    class="text-5xl
                    md:text-6xl
                    font-semibold
                    text-slate-900
                    leading-tight
                    mb-8"
                >
                    Envío automático a la DIAN
                </h2>

                <p
                    class="text-xl
                    text-slate-600
                    leading-relaxed
                    mb-10"
                >
                    Simplificamos el envío y validación de tus documentos
                    electrónicos cumpliendo con la normativa vigente, de forma
                    segura y eficiente.
                </p>

                <div class="space-y-6">
                    <!-- Item 1 -->
                    <div class="flex items-start gap-5">
                        <div
                            class="w-14
                            h-14
                            rounded-2xl
                            bg-cyan-100
                            flex
                            items-center
                            justify-center
                            shrink-0"
                        >
                            <Navigation size={28} className="text-cyan-700" />
                        </div>

                        <div>
                            <h3
                                class="text-2xl
                                font-medium
                                text-slate-900
                                mb-2"
                            >
                                Envío automático y seguro
                            </h3>

                            <p class="text-slate-600 text-lg leading-relaxed">
                                Tus documentos electrónicos son enviados
                                directamente a la DIAN sin procesos manuales.
                            </p>
                        </div>
                    </div>

                    <!-- Item 2 -->
                    <div class="flex items-start gap-5">
                        <div
                            class="w-14
                            h-14
                            rounded-2xl
                            bg-cyan-100
                            flex
                            items-center
                            justify-center
                            shrink-0"
                        >
                            <ShieldCheck size={28} className="text-cyan-700" />
                        </div>

                        <div>
                            <h3
                                class="text-2xl
                                font-medium
                                text-slate-900
                                mb-2"
                            >
                                Validación en tiempo real
                            </h3>

                            <p class="text-slate-600 text-lg leading-relaxed">
                                Recibe respuesta inmediata de la DIAN y conoce
                                el estado de cada documento enviado.
                            </p>
                        </div>
                    </div>

                    <!-- Item 3 -->
                    <div class="flex items-start gap-5">
                        <div
                            class="w-14
                            h-14
                            rounded-2xl
                            bg-cyan-100
                            flex
                            items-center
                            justify-center
                            shrink-0"
                        >
                            <BookCheck size={28} className="text-cyan-700" />
                        </div>

                        <div>
                            <h3
                                class="text-2xl
                                font-medium
                                text-slate-900
                                mb-2"
                            >
                                Cumplimiento normativo garantizado
                            </h3>

                            <p class="text-slate-600 text-lg leading-relaxed">
                                Nos aseguramos de que tus documentos cumplan con
                                todos los requisitos establecidos por la DIAN.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
